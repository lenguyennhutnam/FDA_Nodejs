{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "components/ComingSoon.tsx",
    "components/ErrorBoundary.tsx",
    "components/NhiemVu",
    "components/TimelineChartGantt",
    "components/ThemeSettings",
    "components/UserAvatar",
    "components/ImagePreview",
    "components/TUserGroupComponent",
    "components/print",
    "components/index.tsx",
    "components/notification",
    "components/modal",
    "components/tBaoComThongKe",
    "components/tCalendar",
    "components/tChart",
    "components/tChat",
    "components/tCounponInput",
    "components/tCouponCard",
    "components/tCurrencyTextField",
    "components/tForm2",
    "components/tLabelFetch",
    "components/tModalViewFile",
    "components/tPermissionComponent",
    "components/tRankMilitary",
    "components/tThucDon",
    "components/tWeekSelector",
    "components/tYearPicker",
    "components/tbnv",
    "components/tTableInput"
  ]
}
